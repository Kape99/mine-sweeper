[resource]
script = ExtResource("1_script")
# Mockup page background: light blue-gray.
background = Color(0.815686, 0.85098, 0.890196, 1)
# Board cells: soft blue for unrevealed, white for revealed.
unrevealed = Color(0.541176, 0.678431, 0.968627, 1)
revealed = Color(1, 1, 1, 1)
# Icons/text: dark navy.
flag = Color(0.101961, 0.137255, 0.203922, 1)
# Mine explosion: vivid red.
danger = Color(0.847059, 0.2, 0.290196, 1)
# Long-press neighbor highlight: warm yellow.
highlight = Color(1, 0.878431, 0.4, 1)
# Mine-count numbers: blue to purple.
number_light = Color(0.356863, 0.552941, 0.996078, 1)
number_dark = Color(0.427451, 0.156863, 0.85098, 1)
# Selected chips, borders: bright blue.
accent = Color(0.290196, 0.501961, 0.921569, 1)
# Primary CTA (PLAY DAILY): amber/orange.
primary = Color(0.909804, 0.635294, 0.207843, 1)
# Settings card surface: off-white.
surface = Color(0.980392, 0.980392, 0.984314, 1)
# Text on dark surfaces (daily card labels): white.
inverse_text = Color(1, 1, 1, 1)
# General UI text: dark navy.
hud_text = Color(0.101961, 0.137255, 0.203922, 1)
